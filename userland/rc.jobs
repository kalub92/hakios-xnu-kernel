# Commands run by the launchd job com.redwood.demo (see com.redwood.demo.plist).
# Stage 3b (r1_md_if=1 or r1_md=9): the cellular interface test, in the background from the start; ends at once without the argument. Its lines are kept ("cell_test:").
/redwood/bin/cell_test ifarg r1_md_if=1 &
# Stage 4c: celld publishes the cellular bearer (kern.redwood.cell_*) to configd; ends at once unless r1_md=10/11 or r1_md_iffake=1.
/redwood/bin/celld &
/redwood/bin/hello_dyn started by launchd
/redwood/bin/svc_test
/redwood/bin/surf_test
/bin/ps -A
/redwood/bin/mg_test
# the processors: how many, and -- once the system has settled -- whether they work at the same time
/redwood/bin/cpu_test
# tools/r1-auto.sh's scenario: does nothing unless the kernel was given autotest=1 (rwtouch ifarg). "auto: X" markers
# window the metrics. Camera's last minute and then the home screen are
# measured: pstore keeps only the log's last ~2 minutes.
/redwood/bin/rwtouch ifarg autotest=1 say start wait 85 tap 0.5 0.06 wait 1 notify com.redwood.unlock wait 5 say swipe swipe 0.85 0.45 0.15 0.45 250 wait 4 swipe 0.15 0.45 0.85 0.45 250 wait 4 swipe 0.85 0.45 0.15 0.45 250 wait 4 swipe 0.15 0.45 0.85 0.45 250 wait 4 wait 4
/redwood/bin/rwtouch ifarg autotest=1 say camera notify com.redwood.camera wait 45 notify com.redwood.wktrace say shot1 tap 0.5 0.887 wait 8 say shot2 tap 0.5 0.887 wait 40 say layers1 notify com.redwood.layers wait 5 notify com.redwood.layers wait 2
# nosw=1: the autotest without the home screen swipes (what keeps SpringBoard awake in Camera?)
/redwood/bin/rwtouch ifarg nosw=1 say start wait 85 tap 0.5 0.06 wait 1 notify com.redwood.unlock wait 5 say swipe wait 16 wait 4
/redwood/bin/rwtouch ifarg nosw=1 say camera notify com.redwood.camera wait 45 notify com.redwood.wktrace say shot1 tap 0.5 0.887 wait 8 say shot2 tap 0.5 0.887 wait 40 say layers1 notify com.redwood.layers wait 5 notify com.redwood.layers wait 2
/redwood/bin/rwtouch ifarg autotest=1 say home button home wait 5 swipe 0.85 0.45 0.15 0.45 250 wait 4 swipe 0.15 0.45 0.85 0.45 250 wait 4 swipe 0.85 0.45 0.15 0.45 250 wait 4 swipe 0.15 0.45 0.85 0.45 250 wait 4 swipe 0.85 0.45 0.15 0.45 250 wait 4 swipe 0.15 0.45 0.85 0.45 250 wait 4 wait 6 say end
# sw1=1: ONE swipe; swwait=1: four swipes then 30 s wait; swhome=1: four swipes then a home press (what keeps SpringBoard awake in Camera?)
/redwood/bin/rwtouch ifarg sw1=1 say start wait 85 tap 0.5 0.06 wait 1 notify com.redwood.unlock wait 5 say swipe swipe 0.85 0.45 0.15 0.45 250 wait 4 wait 12 wait 4
/redwood/bin/rwtouch ifarg sw1=1 say camera notify com.redwood.camera wait 45 notify com.redwood.wktrace say shot1 tap 0.5 0.887 wait 8 say shot2 tap 0.5 0.887 wait 40 say layers1 notify com.redwood.layers wait 5 notify com.redwood.layers wait 2
/redwood/bin/rwtouch ifarg swwait=1 say start wait 85 tap 0.5 0.06 wait 1 notify com.redwood.unlock wait 5 say swipe swipe 0.85 0.45 0.15 0.45 250 wait 4 swipe 0.15 0.45 0.85 0.45 250 wait 4 swipe 0.85 0.45 0.15 0.45 250 wait 4 swipe 0.15 0.45 0.85 0.45 250 wait 4 wait 30
/redwood/bin/rwtouch ifarg swwait=1 say camera notify com.redwood.camera wait 45 notify com.redwood.wktrace say shot1 tap 0.5 0.887 wait 8 say shot2 tap 0.5 0.887 wait 40 say layers1 notify com.redwood.layers wait 5 notify com.redwood.layers wait 2
/redwood/bin/rwtouch ifarg swhome=1 say start wait 85 tap 0.5 0.06 wait 1 notify com.redwood.unlock wait 5 say swipe swipe 0.85 0.45 0.15 0.45 250 wait 4 swipe 0.15 0.45 0.85 0.45 250 wait 4 swipe 0.85 0.45 0.15 0.45 250 wait 4 swipe 0.15 0.45 0.85 0.45 250 wait 4 button home wait 5
/redwood/bin/rwtouch ifarg swhome=1 say camera notify com.redwood.camera wait 45 notify com.redwood.wktrace say shot1 tap 0.5 0.887 wait 8 say shot2 tap 0.5 0.887 wait 40 say layers1 notify com.redwood.layers wait 5 notify com.redwood.layers wait 2
# swcam=1: Camera first, then the swipes inside Camera (a touch-sequence effect, or the home screen's page state?)
/redwood/bin/rwtouch ifarg swcam=1 say start wait 85 tap 0.5 0.06 wait 1 notify com.redwood.unlock wait 5 say camera notify com.redwood.camera wait 60 notify com.redwood.wktrace say swipes swipe 0.85 0.45 0.15 0.45 250 wait 4 swipe 0.15 0.45 0.85 0.45 250 wait 4 swipe 0.85 0.45 0.15 0.45 250 wait 4 swipe 0.15 0.45 0.85 0.45 250 wait 4 say after wait 60 say end
# swloop=1: unlock, then ~36 s of continuous home-screen swipes (bb_prof=120 samples them)
/redwood/bin/rwtouch ifarg swloop=1 say start wait 85 tap 0.5 0.06 wait 1 notify com.redwood.unlock wait 5 say swloop swipe 0.85 0.45 0.15 0.45 250 wait 0.35 swipe 0.15 0.45 0.85 0.45 250 wait 0.35 swipe 0.85 0.45 0.15 0.45 250 wait 0.35 swipe 0.15 0.45 0.85 0.45 250 wait 0.35 swipe 0.85 0.45 0.15 0.45 250 wait 0.35 swipe 0.15 0.45 0.85 0.45 250 wait 0.35 swipe 0.85 0.45 0.15 0.45 250 wait 0.35 swipe 0.15 0.45 0.85 0.45 250 wait 0.35 swipe 0.85 0.45 0.15 0.45 250 wait 0.35 swipe 0.15 0.45 0.85 0.45 250 wait 0.35 swipe 0.85 0.45 0.15 0.45 250 wait 0.35 swipe 0.15 0.45 0.85 0.45 250 wait 0.35 swipe 0.85 0.45 0.15 0.45 250 wait 0.35 swipe 0.15 0.45 0.85 0.45 250 wait 0.35 swipe 0.85 0.45 0.15 0.45 250 wait 0.35 swipe 0.15 0.45 0.85 0.45 250 wait 0.35 swipe 0.85 0.45 0.15 0.45 250 wait 0.35 swipe 0.15 0.45 0.85 0.45 250 wait 0.35 swipe 0.85 0.45 0.15 0.45 250 wait 0.35 swipe 0.15 0.45 0.85 0.45 250 wait 0.35 swipe 0.85 0.45 0.15 0.45 250 wait 0.35 swipe 0.15 0.45 0.85 0.45 250 wait 0.35 swipe 0.85 0.45 0.15 0.45 250 wait 0.35 swipe 0.15 0.45 0.85 0.45 250 wait 0.35 swipe 0.85 0.45 0.15 0.45 250 wait 0.35 swipe 0.15 0.45 0.85 0.45 250 wait 0.35 swipe 0.85 0.45 0.15 0.45 250 wait 0.35 swipe 0.15 0.45 0.85 0.45 250 wait 0.35 swipe 0.85 0.45 0.15 0.45 250 wait 0.35 swipe 0.15 0.45 0.85 0.45 250 wait 0.35 swipe 0.85 0.45 0.15 0.45 250 wait 0.35 swipe 0.15 0.45 0.85 0.45 250 wait 0.35 swipe 0.85 0.45 0.15 0.45 250 wait 0.35 swipe 0.15 0.45 0.85 0.45 250 wait 0.35 swipe 0.85 0.45 0.15 0.45 250 wait 0.35 swipe 0.15 0.45 0.85 0.45 250 wait 0.35 swipe 0.85 0.45 0.15 0.45 250 wait 0.35 swipe 0.15 0.45 0.85 0.45 250 wait 0.35 swipe 0.85 0.45 0.15 0.45 250 wait 0.35 swipe 0.15 0.45 0.85 0.45 250 wait 0.35 swipe 0.85 0.45 0.15 0.45 250 wait 0.35 swipe 0.15 0.45 0.85 0.45 250 wait 0.35 swipe 0.85 0.45 0.15 0.45 250 wait 0.35 swipe 0.15 0.45 0.85 0.45 250 wait 0.35 swipe 0.85 0.45 0.15 0.45 250 wait 0.35 swipe 0.15 0.45 0.85 0.45 250 wait 0.35 swipe 0.85 0.45 0.15 0.45 250 wait 0.35 swipe 0.15 0.45 0.85 0.45 250 wait 0.35 swipe 0.85 0.45 0.15 0.45 250 wait 0.35 swipe 0.15 0.45 0.85 0.45 250 wait 0.35 swipe 0.85 0.45 0.15 0.45 250 wait 0.35 swipe 0.15 0.45 0.85 0.45 250 wait 0.35 swipe 0.85 0.45 0.15 0.45 250 wait 0.35 swipe 0.15 0.45 0.85 0.45 250 wait 0.35 swipe 0.85 0.45 0.15 0.45 250 wait 0.35 swipe 0.15 0.45 0.85 0.45 250 wait 0.35 swipe 0.85 0.45 0.15 0.45 250 wait 0.35 swipe 0.15 0.45 0.85 0.45 250 wait 0.35 swipe 0.85 0.45 0.15 0.45 250 wait 0.35 swipe 0.15 0.45 0.85 0.45 250 wait 0.35 say end
# soak=1 (tools/r1-auto.sh without autotest=1): unlock, open Camera and leave it, no taps
/redwood/bin/rwtouch ifarg soak=1 say start wait 85 tap 0.5 0.06 wait 1 notify com.redwood.unlock wait 5 say camera notify com.redwood.camera wait 60 notify com.redwood.wktrace wait 12 say layers1 notify com.redwood.layers wait 5 notify com.redwood.layers wait 1000 say end
# bltest=1 (r1_bl=1): the backlight: slider API 0.10 / 0.90 / 0.30, then lock (factor 0) and wake
/redwood/bin/rwtouch ifarg bltest=1 say start wait 85 tap 0.5 0.06 wait 1 notify com.redwood.unlock wait 5 notify com.redwood.bltest wait 8 button lock wait 6 button lock wait 2 tap 0.5 0.06 wait 1 notify com.redwood.unlock wait 5 say end
# settings=1: unlock, open Settings (Preferences), 15 s, then the fbshot of the run (SHOTS="fbshot=15 fbshot_w=70"): did it crash?
/redwood/bin/rwtouch ifarg settings=1 say start wait 85 tap 0.5 0.06 wait 1 notify com.redwood.unlock wait 5 say settings notify com.redwood.settings wait 15 say end wait 1000
# idle=1: unlock, 90 s on the home screen, end (r1_gov=1: the r1gov: lines show what the governor sees at idle)
/redwood/bin/rwtouch ifarg idle=1 say start wait 85 tap 0.5 0.06 wait 1 notify com.redwood.unlock wait 90 say end
# flip=1 (with r1cam_flip=1): Camera open on the back, tap the flip button (bottom right), 30 s on the front, tap it again, 25 s. Run SECS 250 and SHOTS="fbshot=60 fbshot_every=10 fbshot_w=70" so the last pictures show both
/redwood/bin/rwtouch ifarg flip=1 say start wait 85 tap 0.5 0.06 wait 1 notify com.redwood.unlock wait 5 say camera notify com.redwood.camera wait 60 say flip1 tap 0.9 0.87 wait 8 say flip1b wait 22 say flip2 tap 0.9 0.87 wait 8 say flip2b wait 17 say end
/redwood/bin/cpu_test 240 &
