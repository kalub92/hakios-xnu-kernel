; pvr_vk_test's vertex shader (userland/src/pvr_vk_test.c has it in GLSL)
               OpCapability Shader
               OpMemoryModel Logical GLSL450
               OpEntryPoint Vertex %main "main" %in_pos %in_col %out_col %gl_out
               OpDecorate %in_pos Location 0
               OpDecorate %in_col Location 1
               OpDecorate %out_col Location 0
               OpMemberDecorate %PerVertex 0 BuiltIn Position
               OpDecorate %PerVertex Block
       %void = OpTypeVoid
     %fnvoid = OpTypeFunction %void
      %float = OpTypeFloat 32
       %vec2 = OpTypeVector %float 2
       %vec3 = OpTypeVector %float 3
       %vec4 = OpTypeVector %float 4
  %PerVertex = OpTypeStruct %vec4
 %ptr_out_pv = OpTypePointer Output %PerVertex
     %gl_out = OpVariable %ptr_out_pv Output
        %int = OpTypeInt 32 1
      %int_0 = OpConstant %int 0
%ptr_in_vec2 = OpTypePointer Input %vec2
%ptr_in_vec3 = OpTypePointer Input %vec3
%ptr_out_vec3 = OpTypePointer Output %vec3
%ptr_out_vec4 = OpTypePointer Output %vec4
     %in_pos = OpVariable %ptr_in_vec2 Input
     %in_col = OpVariable %ptr_in_vec3 Input
    %out_col = OpVariable %ptr_out_vec3 Output
    %float_0 = OpConstant %float 0
    %float_1 = OpConstant %float 1
       %main = OpFunction %void None %fnvoid
      %entry = OpLabel
          %p = OpLoad %vec2 %in_pos
         %px = OpCompositeExtract %float %p 0
         %py = OpCompositeExtract %float %p 1
        %pos = OpCompositeConstruct %vec4 %px %py %float_0 %float_1
        %dst = OpAccessChain %ptr_out_vec4 %gl_out %int_0
               OpStore %dst %pos
          %c = OpLoad %vec3 %in_col
               OpStore %out_col %c
               OpReturn
               OpFunctionEnd
