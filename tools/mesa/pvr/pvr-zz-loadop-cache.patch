-   result = pvr_arch_load_op_shader_generate(device, alloc, load_op);
+   result = pvr_load_op_shader_get_cached(device, alloc, load_op);
    if (result != VK_SUCCESS) {
       vk_free2(&device->vk.alloc, alloc, load_op);
       return result;
@@ -362,6 +551,9 @@
 
