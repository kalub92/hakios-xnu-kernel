+
+/*
+ * Darwin on redwood: the load-op shader of a dynamic render pass, kept for the device's life.
+ *
+ * With dynamic rendering (Zink) every vkCmdBeginRendering with a load or clear made a load-op
+ * shader through the compiler plus two PDS programs, 2 ms of a 3.3 ms pass, and freed them at the
+ * end of the command buffer. What pvr_uscgen_loadop() reads (pvr_usc.c) is all in the key below:
+ * the clear/load/2d-view-of-3d/msaa masks, depth_clear_to_reg, and for each render target of the
+ * clear|load mask its format and where its MRT resource lives (type, register or tile buffer,
+ * offset). The device (pco_ctx, dev_info) is the cache's owner. Never read besides: the PDS
+ * programs depend on the shader's entry offset, temps and msaa, which the entry keeps with it.
+ * What came out -- the three programs and four counts -- is shared by every load op of the key
+ * (progs_cached: pvr_load_op_fini does not free them). PVR_LOADOP_CACHE=0 turns it off; past
+ * PVR_LOADOP_CACHE_MAX entries a pass is made the old way, and a line says so.
+ */
+#include <stdlib.h>
+extern int sysctlbyname(const char *, void *, size_t *, void *, size_t);
+
+struct pvr_loadop_key {
+   uint16_t rt_clear_mask, rt_load_mask, rt_2d_view_3d_mask, unresolved_msaa_mask;
+   int32_t depth_clear_to_reg;
+   uint32_t color_init_count;
+   struct {
+      uint32_t format;
+      uint32_t type;
+      uint32_t a, b; /* register: output_reg, 0. memory: tile_buffer, offset_dw */
+   } rt[PVR_LOAD_OP_CLEARS_LOADS_MAX_RTS];
+};
+
+struct pvr_loadop_entry {
+   struct pvr_loadop_key key;
+   uint32_t hash;
+   struct pvr_suballoc_bo *usc_frag_prog_bo;
+   struct pvr_pds_upload pds_frag_prog;
+   struct pvr_pds_upload pds_tex_state_prog;
+   uint32_t const_shareds_count, shareds_count, num_tile_buffers, temps_count;
+};
+
+static void pvr_loadop_cache_say(struct pvr_device *device, int64_t now)
+{
+   char line[200];
+
+   snprintf(line,
+            sizeof(line),
+            "!MESA: pvr: load-op cache: %u entries, %u hits, %u misses, %u uncached (cache full)",
+            device->loadop_cache.count,
+            device->loadop_cache.hits,
+            device->loadop_cache.misses,
+            device->loadop_cache.full);
+   device->loadop_cache.said = now;
+   device->loadop_cache.hits = device->loadop_cache.misses = device->loadop_cache.full = 0;
+   sysctlbyname("kern.redwood.say", NULL, NULL, line, strlen(line));
+}
+
+static void pvr_loadop_key_init(struct pvr_loadop_key *key, const struct pvr_load_op *load_op)
+{
+   const struct usc_mrt_setup *mrt_setup = load_op->clears_loads_state.mrt_setup;
+   const unsigned rt_mask = load_op->clears_loads_state.rt_clear_mask | load_op->clears_loads_state.rt_load_mask;
+
+   memset(key, 0, sizeof(*key));
+   key->rt_clear_mask = load_op->clears_loads_state.rt_clear_mask;
+   key->rt_load_mask = load_op->clears_loads_state.rt_load_mask;
+   key->rt_2d_view_3d_mask = load_op->clears_loads_state.rt_2d_view_3d_mask;
+   key->unresolved_msaa_mask = load_op->clears_loads_state.unresolved_msaa_mask;
+   key->depth_clear_to_reg = load_op->clears_loads_state.depth_clear_to_reg;
+   u_foreach_bit (i, rt_mask) {
+      const struct usc_mrt_resource *res = &mrt_setup->mrt_resources[i];
+
+      key->rt[i].format = load_op->clears_loads_state.dest_vk_format[i];
+      key->rt[i].type = res->type;
+      if (res->type == USC_MRT_RESOURCE_TYPE_OUTPUT_REG) {
+         key->rt[i].a = res->reg.output_reg;
+      } else {
+         key->rt[i].a = res->mem.tile_buffer;
+         key->rt[i].b = res->mem.offset_dw;
+      }
+   }
+}
+
+static VkResult pvr_load_op_shader_get_cached(struct pvr_device *device,
+                                              const VkAllocationCallbacks *alloc,
+                                              struct pvr_load_op *load_op)
+{
+   struct pvr_loadop_key key;
+   struct pvr_loadop_entry *entry = NULL;
+   uint32_t hash;
+   VkResult result;
+   int64_t now;
+
+   simple_mtx_lock(&device->loadop_cache.mtx);
+   if (device->loadop_cache.enabled < 0) {
+      const char *env = getenv("PVR_LOADOP_CACHE");
+
+      device->loadop_cache.enabled = !(env && !strcmp(env, "0"));
+   }
+   if (!device->loadop_cache.enabled ||
+       load_op->clears_loads_state.depth_clear_to_reg != PVR_NO_DEPTH_CLEAR_TO_REG) {
+      simple_mtx_unlock(&device->loadop_cache.mtx);
+      return pvr_arch_load_op_shader_generate(device, alloc, load_op);
+   }
+
+   pvr_loadop_key_init(&key, load_op);
+   hash = _mesa_hash_data(&key, sizeof(key));
+
+   for (uint32_t i = 0; i < device->loadop_cache.count; i++) {
+      struct pvr_loadop_entry *e = device->loadop_cache.entries[i];
+
+      if (e->hash == hash && !memcmp(&e->key, &key, sizeof(key))) {
+         entry = e;
+         break;
+      }
+   }
+
+   if (entry) {
+      device->loadop_cache.hits++;
+   } else {
+      /* a miss: made with the lock held, so two threads do not make the same one (rare: the lock is
+       * held for a compile only the first time a kind of pass is seen) */
+      device->loadop_cache.misses++;
+      result = pvr_arch_load_op_shader_generate(device, alloc, load_op);
+      if (result != VK_SUCCESS) {
+         simple_mtx_unlock(&device->loadop_cache.mtx);
+         return result;
+      }
+
+      if (device->loadop_cache.count >= PVR_LOADOP_CACHE_MAX ||
+          !(entry = calloc(1, sizeof(*entry)))) {
+         /* the load op keeps what it made (progs_cached stays false: it frees them) */
+         device->loadop_cache.full++;
+         now = os_time_get_nano();
+         if (!device->loadop_cache.said || now - device->loadop_cache.said > 10000000000ll)
+            pvr_loadop_cache_say(device, now);
+         simple_mtx_unlock(&device->loadop_cache.mtx);
+         return VK_SUCCESS;
+      }
+
+      entry->key = key;
+      entry->hash = hash;
+      entry->usc_frag_prog_bo = load_op->usc_frag_prog_bo;
+      entry->pds_frag_prog = load_op->pds_frag_prog;
+      entry->pds_tex_state_prog = load_op->pds_tex_state_prog;
+      entry->const_shareds_count = load_op->const_shareds_count;
+      entry->shareds_count = load_op->shareds_count;
+      entry->num_tile_buffers = load_op->num_tile_buffers;
+      entry->temps_count = load_op->temps_count;
+      device->loadop_cache.entries[device->loadop_cache.count++] = entry;
+
+      /* the entry owns the programs now */
+      load_op->progs_cached = true;
+      now = os_time_get_nano();
+      if (!device->loadop_cache.said || now - device->loadop_cache.said > 10000000000ll)
+         pvr_loadop_cache_say(device, now);
+      simple_mtx_unlock(&device->loadop_cache.mtx);
+      return VK_SUCCESS;
+   }
+
+   load_op->progs_cached = true;
+   load_op->usc_frag_prog_bo = entry->usc_frag_prog_bo;
+   load_op->pds_frag_prog = entry->pds_frag_prog;
+   load_op->pds_tex_state_prog = entry->pds_tex_state_prog;
+   load_op->const_shareds_count = entry->const_shareds_count;
+   load_op->shareds_count = entry->shareds_count;
+   load_op->num_tile_buffers = entry->num_tile_buffers;
+   load_op->temps_count = entry->temps_count;
+
+   now = os_time_get_nano();
+   if (!device->loadop_cache.said || now - device->loadop_cache.said > 10000000000ll)
+      pvr_loadop_cache_say(device, now);
+   simple_mtx_unlock(&device->loadop_cache.mtx);
+   return VK_SUCCESS;
+}
+
+void pvr_arch_loadop_cache_finish(struct pvr_device *device)
+{
+   for (uint32_t i = 0; i < device->loadop_cache.count; i++) {
+      struct pvr_loadop_entry *e = device->loadop_cache.entries[i];
+
+      pvr_bo_suballoc_free(e->pds_tex_state_prog.pvr_bo);
+      pvr_bo_suballoc_free(e->pds_frag_prog.pvr_bo);
+      pvr_bo_suballoc_free(e->usc_frag_prog_bo);
+      free(e);
+   }
+   device->loadop_cache.count = 0;
+   simple_mtx_destroy(&device->loadop_cache.mtx);
+}
+
