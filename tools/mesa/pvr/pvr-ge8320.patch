+ * of those Mesa knows 35421 and 38748. ERN 42307 is not in the firmware's list (the kernel's
+ * table has no bit for it): [8300].
+ */
+static const struct pvr_device_enhancements
+   pvr_device_enhancements_22_87_104_18 = {
+      .has_ern35421 = true, /* [FW] */
+      .has_ern38748 = true, /* [FW] */
+      .has_ern42307 = true, /* [8300] */
+   };
