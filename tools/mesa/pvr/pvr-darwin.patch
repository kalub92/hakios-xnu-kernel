+/*
+ * Darwin on redwood: render target data kept for the next render pass of the same size.
+ *
+ * With dynamic rendering -- which is all Zink does -- every render pass makes its own (the FIXME
+ * in pvr_arch_cmd_buffer.c): a free list, four buffers and the kernel's data, made when the pass
+ * begins and given back when its command buffer is reset. For a window server that is two or
+ * three of them a frame, and most of what the kernel is asked in a frame (the r1, 13 November
+ * 2026: 211 of each made and 206 destroyed in ten seconds, with some 1600 buffers).
+ *
+ * What is given back goes here instead, and the next pass that wants one of that size takes it:
+ * no pass shares one with another, any more than before, and one is used again only when it
+ * would have been destroyed -- as a framebuffer's is used for every pass into that framebuffer.
+ * At most PVR_RT_POOL are kept, the one longest unused going first, and none longer than ten
+ * seconds unused.
+ */
+#include "util/os_time.h"
+#include "util/simple_mtx.h"
+
+#define PVR_RT_POOL 12
+#define PVR_RT_POOL_NS 10000000000ll
+
+static struct {
+   struct pvr_rt_dataset *rt_dataset;
+   int64_t since;
+} pvr_rt_pool[PVR_RT_POOL];
+static simple_mtx_t pvr_rt_pool_mtx = SIMPLE_MTX_INITIALIZER;
+
+static void pvr_rt_dataset_destroy_now(struct pvr_rt_dataset *rt_dataset);
+
+/* With the lock held: those unused too long (all of `device`'s, with `all`) are taken out; they are
+ * destroyed by the caller, without the lock (at most PVR_RT_POOL of them, in `out`).
+ */
+static unsigned pvr_rt_pool_expire(const struct pvr_device *device,
+                                   bool all,
+                                   struct pvr_rt_dataset **out)
+{
+   const int64_t now = os_time_get_nano();
+   unsigned count = 0;
+
+   for (unsigned i = 0; i < PVR_RT_POOL; i++) {
+      struct pvr_rt_dataset *const rt_dataset = pvr_rt_pool[i].rt_dataset;
+
+      if (!rt_dataset)
+         continue;
+
+      if (all ? rt_dataset->device == device
+              : now - pvr_rt_pool[i].since > PVR_RT_POOL_NS) {
+         out[count++] = rt_dataset;
+         pvr_rt_pool[i].rt_dataset = NULL;
+      }
+   }
+
+   return count;
+}
+
+struct pvr_rt_dataset *pvr_rt_dataset_pool_take(const struct pvr_device *device,
+                                                uint32_t width,
+                                                uint32_t height,
+                                                uint32_t samples,
+                                                uint32_t layers)
+{
+   struct pvr_rt_dataset *found = NULL;
+
+   simple_mtx_lock(&pvr_rt_pool_mtx);
+   for (unsigned i = 0; i < PVR_RT_POOL && !found; i++) {
+      struct pvr_rt_dataset *const rt_dataset = pvr_rt_pool[i].rt_dataset;
+
+      if (rt_dataset && rt_dataset->device == device &&
+          rt_dataset->width == width && rt_dataset->height == height &&
+          rt_dataset->samples == samples && rt_dataset->layers == layers) {
+         found = rt_dataset;
+         pvr_rt_pool[i].rt_dataset = NULL;
+      }
+   }
+   simple_mtx_unlock(&pvr_rt_pool_mtx);
+
+   return found;
+}
+
+void pvr_rt_dataset_pool_drain(const struct pvr_device *device)
+{
+   struct pvr_rt_dataset *gone[PVR_RT_POOL];
+   unsigned count;
+
+   simple_mtx_lock(&pvr_rt_pool_mtx);
+   count = pvr_rt_pool_expire(device, true, gone);
+   simple_mtx_unlock(&pvr_rt_pool_mtx);
+
+   for (unsigned i = 0; i < count; i++)
+      pvr_rt_dataset_destroy_now(gone[i]);
+}
+
 void pvr_render_target_dataset_destroy(struct pvr_rt_dataset *rt_dataset)
 {
+#ifdef __APPLE__
+   struct pvr_rt_dataset *gone[PVR_RT_POOL + 1];
+   unsigned count, oldest = 0;
+   int slot = -1;
+
+   simple_mtx_lock(&pvr_rt_pool_mtx);
+   count = pvr_rt_pool_expire(rt_dataset->device, false, gone);
+   for (unsigned i = 0; i < PVR_RT_POOL; i++) {
+      if (!pvr_rt_pool[i].rt_dataset) {
+         slot = i;
+         break;
+      }
+
+      if (pvr_rt_pool[i].since < pvr_rt_pool[oldest].since)
+         oldest = i;
+   }
+
+   if (slot < 0) {
+      gone[count++] = pvr_rt_pool[oldest].rt_dataset;
+      slot = oldest;
+   }
+
+   pvr_rt_pool[slot].rt_dataset = rt_dataset;
+   pvr_rt_pool[slot].since = os_time_get_nano();
+   simple_mtx_unlock(&pvr_rt_pool_mtx);
+
+   for (unsigned i = 0; i < count; i++)
+      pvr_rt_dataset_destroy_now(gone[i]);
+#else
+   pvr_rt_dataset_destroy_now(rt_dataset);
+#endif
+}
