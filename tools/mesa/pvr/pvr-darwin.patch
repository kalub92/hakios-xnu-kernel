+/*
+ * Darwin on redwood: buffers kept for the next who asks for the same.
+ *
+ * A render pass's control stream, the buffers the suballocators deal PDS and USC programs and
+ * state out of: made for a command buffer and given back when it is reset, some fourteen of them a
+ * frame for a window server, each of them a buffer made in the kernel, mapped for the GPU and for
+ * this program, and all of that undone again (the r1, 13 November 2026: 1599 made and 1558 closed
+ * in ten seconds, a tenth of that time). A buffer that is given back is kept here as it is --
+ * mapped -- and handed out, cleared, to whoever asks next for one of its heap, size and kind.
+ * Only buffers this program has mapped (which it can clear, as the kernel clears a new one), of
+ * no more than PVR_BO_CACHE_MOST bytes; PVR_BO_CACHE_BYTES of them at most, none longer than five
+ * seconds unused.
  */
+#define PVR_BO_CACHE 128
+#define PVR_BO_CACHE_MOST (1024 * 1024)
+#define PVR_BO_CACHE_BYTES (32 * 1024 * 1024)
+#define PVR_BO_CACHE_NS 5000000000ll
+
+static struct {
+   struct pvr_bo *bo;
+   int64_t since;
+} pvr_bo_cache[PVR_BO_CACHE];
+static uint64_t pvr_bo_cache_bytes;
+static const struct pvr_device *pvr_bo_cache_closed;
+static simple_mtx_t pvr_bo_cache_mtx = SIMPLE_MTX_INITIALIZER;
+
+static void pvr_bo_free_now(struct pvr_device *device, struct pvr_bo *pvr_bo);
+
+/* Counters, said every ten seconds (the r1's own "pvr:" lines, through kern.redwood.say). */
+#include <stdlib.h>
+extern int sysctlbyname(const char *, void *, size_t *, void *, size_t);
+static struct {
+   uint32_t misses;
+   struct { uint64_t size, flags; uint32_t n; } kinds[32];
+   uint64_t cleared, cleared_ns;
+   int64_t said;
+} pvr_bo_stats;
+
+/* PVR_BO_CACHE_CLEAR=0: a buffer out of the cache is not cleared (anything else: it is). */
+static bool pvr_bo_cache_clears(void)
+{
+   static int clears = -1;
+
+   if (clears < 0) {
+      const char *const env = getenv("PVR_BO_CACHE_CLEAR");
+
+      clears = !(env && !strcmp(env, "0"));
+   }
+   return clears;
+}
+
+/* A buffer asked for: made past the cache when "miss". */
+static void pvr_bo_cache_say(bool miss, uint64_t size, uint64_t flags)
+{
+   const int64_t now = os_time_get_nano();
+   char line[300];
+   unsigned top[3] = { 32, 32, 32 };
+   int len;
+
+   simple_mtx_lock(&pvr_bo_cache_mtx);
+   if (miss) {
+      unsigned i = 0;
+
+      pvr_bo_stats.misses++;
+      while (i < 31 && pvr_bo_stats.kinds[i].n &&
+             !(pvr_bo_stats.kinds[i].size == size && pvr_bo_stats.kinds[i].flags == flags))
+         i++;
+      pvr_bo_stats.kinds[i].size = size;
+      pvr_bo_stats.kinds[i].flags = flags;
+      pvr_bo_stats.kinds[i].n++;
+   }
+   if (!pvr_bo_stats.said)
+      pvr_bo_stats.said = now;
+   if (now - pvr_bo_stats.said < 10000000000ll) {
+      simple_mtx_unlock(&pvr_bo_cache_mtx);
+      return;
+   }
+   for (unsigned k = 0; k < 3; k++)
+      for (unsigned i = 0; i < 32; i++)
+         if (pvr_bo_stats.kinds[i].n && i != top[0] && i != top[1] &&
+             (top[k] == 32 || pvr_bo_stats.kinds[i].n > pvr_bo_stats.kinds[top[k]].n))
+            top[k] = i;
+   len = snprintf(line, sizeof(line), "!MESA: pvr: 10 s: %u buffers made past the cache; top sizes/flags:",
+                  pvr_bo_stats.misses);
+   for (unsigned k = 0; k < 3; k++)
+      if (top[k] < 32)
+         len += snprintf(line + len, sizeof(line) - len, " %llu/%#llx x%u",
+                         (unsigned long long)pvr_bo_stats.kinds[top[k]].size,
+                         (unsigned long long)pvr_bo_stats.kinds[top[k]].flags, pvr_bo_stats.kinds[top[k]].n);
+   snprintf(line + len, sizeof(line) - len, "; cleared %llu bytes in %llu us",
+            (unsigned long long)pvr_bo_stats.cleared, (unsigned long long)(pvr_bo_stats.cleared_ns / 1000));
+   memset(&pvr_bo_stats, 0, sizeof(pvr_bo_stats));
+   pvr_bo_stats.said = now;
+   simple_mtx_unlock(&pvr_bo_cache_mtx);
+   sysctlbyname("kern.redwood.say", NULL, NULL, line, strlen(line));
+}
+
+static struct pvr_bo *pvr_bo_cache_take(const struct pvr_device *device,
+                                        const struct pvr_winsys_heap *heap,
+                                        uint64_t size,
+                                        uint64_t alignment,
+                                        uint64_t flags)
+{
+   const int64_t now = os_time_get_nano();
+   struct pvr_bo *found = NULL;
+
+   size = ALIGN_POT(ALIGN_POT(size, alignment), device->ws->page_size);
+   /* (flags 0 -- no CPU access at all -- are kept too, as they are and not cleared: this program
+    * cannot reach them, the GPU is what writes them; any other flags without a mapping are left alone) */
+   if (flags && !(flags & PVR_BO_ALLOC_FLAG_CPU_MAPPED))
+      return NULL;
+   if (size > PVR_BO_CACHE_MOST)
+      return NULL;
+
+   simple_mtx_lock(&pvr_bo_cache_mtx);
+   for (unsigned i = 0; i < PVR_BO_CACHE && !found; i++) {
+      struct pvr_bo *const bo = pvr_bo_cache[i].bo;
+
+      /* (flags 0: the GPU may still be reading it a frame or two after it is given back: not before 100 ms) */
+      if (bo && (flags || now - pvr_bo_cache[i].since > 100000000ll) && bo->vma->heap == heap && bo->bo->size == size &&
+          bo->alloc_flags == flags && bo->bo->ws == device->ws &&
+          !(bo->vma->dev_addr.addr & (alignment - 1))) {
+         found = bo;
+         pvr_bo_cache[i].bo = NULL;
+         pvr_bo_cache_bytes -= size;
+      }
+   }
+   simple_mtx_unlock(&pvr_bo_cache_mtx);
+
+   if (found) {
+      /* (as new: the kernel's are cleared) */
+      if (found->bo->map && pvr_bo_cache_clears()) {
+         const int64_t t0 = os_time_get_nano();
+
+         memset(found->bo->map, 0, found->bo->size);
+         simple_mtx_lock(&pvr_bo_cache_mtx);
+         pvr_bo_stats.cleared += found->bo->size;
+         pvr_bo_stats.cleared_ns += os_time_get_nano() - t0;
+         simple_mtx_unlock(&pvr_bo_cache_mtx);
+      }
+      found->ref_count = 1;
+   }
+
+   return found;
+}
+
+/* True: kept. */
+static bool pvr_bo_cache_put(struct pvr_device *device, struct pvr_bo *pvr_bo)
+{
+   const int64_t now = os_time_get_nano();
+   struct pvr_bo *gone[PVR_BO_CACHE];
+   unsigned count = 0, oldest = 0;
+   bool kept = false;
+   int slot = -1;
+
+   if ((pvr_bo->alloc_flags ? (!(pvr_bo->alloc_flags & PVR_BO_ALLOC_FLAG_CPU_MAPPED) || !pvr_bo->bo->map) : false) ||
+       pvr_bo->bo->size > PVR_BO_CACHE_MOST || device->bo_store)
+      return false;
+
+   simple_mtx_lock(&pvr_bo_cache_mtx);
+   if (pvr_bo_cache_closed != device) {
+      for (unsigned i = 0; i < PVR_BO_CACHE; i++) {
+         if (pvr_bo_cache[i].bo && now - pvr_bo_cache[i].since > PVR_BO_CACHE_NS) {
+            gone[count++] = pvr_bo_cache[i].bo;
+            pvr_bo_cache_bytes -= pvr_bo_cache[i].bo->bo->size;
+            pvr_bo_cache[i].bo = NULL;
+         }
+      }
+
+      for (unsigned i = 0; i < PVR_BO_CACHE; i++) {
+         if (!pvr_bo_cache[i].bo) {
+            slot = i;
+            break;
+         }
+
+         if (pvr_bo_cache[i].since < pvr_bo_cache[oldest].since)
+            oldest = i;
+      }
+
+      if (slot < 0) {
+         gone[count++] = pvr_bo_cache[oldest].bo;
+         pvr_bo_cache_bytes -= pvr_bo_cache[oldest].bo->bo->size;
+         slot = oldest;
+      }
+
+      if (pvr_bo_cache_bytes + pvr_bo->bo->size <= PVR_BO_CACHE_BYTES) {
+         pvr_bo_cache[slot].bo = pvr_bo;
+         pvr_bo_cache[slot].since = now;
+         pvr_bo_cache_bytes += pvr_bo->bo->size;
+         kept = true;
+      } else {
+         pvr_bo_cache[slot].bo = NULL;
+      }
+   }
+   simple_mtx_unlock(&pvr_bo_cache_mtx);
+
+   for (unsigned i = 0; i < count; i++)
+      pvr_bo_free_now(device, gone[i]);
+
+   return kept;
+}
+
+/* All of them given back for good, and none kept from here on: the device is going. */
+void pvr_bo_cache_drain(struct pvr_device *device)
+{
+   struct pvr_bo *gone[PVR_BO_CACHE];
+   unsigned count = 0;
+
+   simple_mtx_lock(&pvr_bo_cache_mtx);
+   pvr_bo_cache_closed = device;
+   for (unsigned i = 0; i < PVR_BO_CACHE; i++) {
+      if (pvr_bo_cache[i].bo && pvr_bo_cache[i].bo->bo->ws == device->ws) {
+         gone[count++] = pvr_bo_cache[i].bo;
+         pvr_bo_cache_bytes -= pvr_bo_cache[i].bo->bo->size;
+         pvr_bo_cache[i].bo = NULL;
+      }
+   }
+   simple_mtx_unlock(&pvr_bo_cache_mtx);
+
+   for (unsigned i = 0; i < count; i++)
+      pvr_bo_free_now(device, gone[i]);
+}
