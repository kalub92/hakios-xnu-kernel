+
+/*
+ * Darwin on redwood: end-of-tile programs kept.
+ *
+ * Every render pass has the compiler make two of these -- one when its render state is set up
+ * (pvr_arch_spm.c), one when its commands are ended (pvr_arch_cmd_buffer.c) --, and with dynamic
+ * rendering every pass is new: a window server's frame, the same pass into the same kind of
+ * picture sixty times a second, compiled the same two programs every time, which was most of
+ * what a frame cost this driver's side (the r1, 14 November 2026: 9 to 15 ms in glFlush for a
+ * frame of one render pass). What a program is made of is all in its properties; one made
+ * once is kept by them, for good -- PVR_EOT_KEPT of them, and past that they are compiled as
+ * before.
+ */
+#include "util/simple_mtx.h"
+
+#define PVR_EOT_KEPT 32
+
+struct pvr_eot_key {
+   const void *ctx;
+   unsigned emit_count;
+   unsigned msaa_samples;
+   unsigned num_output_regs;
+   uint32_t state_words[PVR_MAX_COLOR_ATTACHMENTS *
+                        ROGUE_NUM_PBESTATE_STATE_WORDS];
+   uint64_t tile_buffer_addrs[PVR_MAX_COLOR_ATTACHMENTS];
+};
+
+static struct {
+   struct pvr_eot_key key;
+   void *data;
+   unsigned size;
+   unsigned temps;
+} pvr_eot_kept[PVR_EOT_KEPT];
+static unsigned pvr_eot_kept_count;
+static simple_mtx_t pvr_eot_kept_mtx = SIMPLE_MTX_INITIALIZER;
+
+bool pvr_usc_eot_kept(pco_ctx *ctx,
+                      struct pvr_eot_props *props,
+                      const struct pvr_device_info *dev_info,
+                      const void **data_out,
+                      unsigned *size_out,
+                      unsigned *temps_out)
+{
+   struct pvr_eot_key key;
+   bool found = false;
+   pco_shader *eot;
+   void *data;
+
+   if (props->shared_words || props->emit_count > PVR_MAX_COLOR_ATTACHMENTS)
+      return false;
+
+   memset(&key, 0, sizeof(key));
+   key.ctx = ctx;
+   key.emit_count = props->emit_count;
+   key.msaa_samples = props->msaa_samples;
+   key.num_output_regs = props->num_output_regs;
+   memcpy(key.state_words,
+          props->state_words,
+          props->emit_count * ROGUE_NUM_PBESTATE_STATE_WORDS *
+             sizeof(key.state_words[0]));
+   memcpy(key.tile_buffer_addrs,
+          props->tile_buffer_addrs,
+          sizeof(key.tile_buffer_addrs));
+
+   simple_mtx_lock(&pvr_eot_kept_mtx);
+   for (unsigned i = 0; i < pvr_eot_kept_count && !found; i++) {
+      if (!memcmp(&pvr_eot_kept[i].key, &key, sizeof(key))) {
+         *data_out = pvr_eot_kept[i].data;
+         *size_out = pvr_eot_kept[i].size;
+         *temps_out = pvr_eot_kept[i].temps;
+         found = true;
+      }
+   }
+
+   if (!found && pvr_eot_kept_count < PVR_EOT_KEPT) {
+      eot = pvr_usc_eot(ctx, props, dev_info);
+      data = malloc(pco_shader_binary_size(eot));
+      if (data) {
+         memcpy(data, pco_shader_binary_data(eot), pco_shader_binary_size(eot));
+         pvr_eot_kept[pvr_eot_kept_count].key = key;
+         pvr_eot_kept[pvr_eot_kept_count].data = data;
+         pvr_eot_kept[pvr_eot_kept_count].size = pco_shader_binary_size(eot);
+         pvr_eot_kept[pvr_eot_kept_count].temps =
+            pco_shader_data(eot)->common.temps;
+         *data_out = data;
+         *size_out = pvr_eot_kept[pvr_eot_kept_count].size;
+         *temps_out = pvr_eot_kept[pvr_eot_kept_count].temps;
+         pvr_eot_kept_count++;
+         found = true;
+      }
+      ralloc_free(eot);
+   }
+   simple_mtx_unlock(&pvr_eot_kept_mtx);
+
+   return found;
 }
 
