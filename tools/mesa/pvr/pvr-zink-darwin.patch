+                  "known finished %u", submits, bs->ctx->batch_states_count, (unsigned)screen->curr_batch, screen->last_finished);
+         sysctlbyname("kern.redwood.say", NULL, NULL, line, strlen(line));
+         submits = 0;
+         said = now;
+      }
+   }
+#endif
