+      memcpy(waits, submit->waits, sizeof(*waits) * submit->wait_count);
+      for (uint32_t i = 0; i < old_count; i++) {
+         waits[wait_count++] = (struct vk_sync_wait){
+            .sync = old[i],
+            .stage_mask = ~(VkPipelineStageFlags2)0,
+            .wait_value = 0,
