+      nowait = !getenv("PVR_NOWAIT") || atoi(getenv("PVR_NOWAIT")) != 0;
+      mesa_logi("pvr: PVR_NOWAIT=%d: submissions %s", nowait, nowait ? "not waited for" : "waited for");
+   }
+
+   if (nowait) {
+      struct vk_sync *old[PVR_JOB_TYPE_MAX * 2];
+      uint32_t old_count = 0, wait_count = submit->wait_count;
